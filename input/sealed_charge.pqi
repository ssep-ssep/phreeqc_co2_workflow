SELECTED_OUTPUT 1
    -file output/sealed_charge.tsv
    -high_precision true
    -reset false
    -simulation true
    -solution true
    -state true
    -pH true
    -alkalinity true
    -ionic_strength true
    -water true
    -charge_balance true
    -percent_error true
    -totals C K Nti
    -molalities CO2 HCO3- CO3-2 KHCO3 (CO2)2 H+ OH- NtiO2- HNtiO2
    -activities H+ CO2 HCO3- CO3-2
    -equilibrium_phases CO2(g)
    -saturation_indices CO2(g)
USER_PUNCH 1
    -headings solution_volume_L water_activity phi_CO2 inferred_pCO2_atm
    -start
    10 phi = PR_PHI("CO2(g)")
    20 IF phi <= 0 THEN phi = 1
    30 PUNCH SOLN_VOL, ACT("H2O"), phi, 10^SI("CO2(g)")/phi
    -end

TITLE 充气表压=0.1 MPa
SOLUTION 1
    temp 25
    pressure 1
    units mol/L
    pH 8.3
    K 0.2
    Alkalinity 0.2 as HCO3
    -water 1
REACTION_PRESSURE 1
    1.986923266716013
EQUILIBRIUM_PHASES 1
    CO2(g) -0.09037815655132085 100
    -force_equality true
END

