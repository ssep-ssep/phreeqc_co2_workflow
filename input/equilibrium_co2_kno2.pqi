SOLUTION_MASTER_SPECIES
    Nti NtiO2- 0 Nti 14.0067
SOLUTION_SPECIES
    NtiO2- = NtiO2-
        -gamma 3 0
        -Vm 5.5864 5.859 3.4472 -3.0212 1.1847
    NtiO2- + H+ = HNtiO2
        -log_k 3.16

SELECTED_OUTPUT 1
    -file output/equilibrium_co2_kno2.tsv
    -high_precision true
    -reset false
    -simulation true
    -solution true
    -state true
    -pH true
    -alkalinity true
    -ionic_strength true
    -water true
    -charge_balance true
    -percent_error true
    -totals C K Nti
    -molalities CO2 HCO3- CO3-2 KHCO3 (CO2)2 H+ OH- NtiO2- HNtiO2
    -activities H+ CO2 HCO3- CO3-2
    -equilibrium_phases CO2(g)
    -saturation_indices CO2(g)
USER_PUNCH 1
    -headings solution_volume_L water_activity phi_CO2 inferred_pCO2_atm
    -start
    10 phi = PR_PHI("CO2(g)")
    20 IF phi <= 0 THEN phi = 1
    30 PUNCH SOLN_VOL, ACT("H2O"), phi, 10^SI("CO2(g)")/phi
    -end

TITLE gauge=0 MPa KNO2
SOLUTION 1
    temp 25
    pressure 1
    units mol/L
    pH 8.3
    K 0.22
    Alkalinity 0.2 as HCO3
    Nti 0.02
    -water 1
REACTION_PRESSURE 1
    1
EQUILIBRIUM_PHASES 1
    CO2(g) -0.01370311508100605 100.0
    -force_equality true
END

