	SELECTED_OUTPUT 1
	    file output/equilibrium_co2_realno2.tsv
	    high_precision true
	    reset false
	    simulation true
	    solution true
	    state true
	    ph true
	    alkalinity true
	    ionic_strength true
	    water true
	    charge_balance true
	    percent_error true
	    totals C K Nti
	    molalities CO2 HCO3- CO3-2 KHCO3 (CO2)2 H+ OH- NtiO2- HNtiO2
	    activities H+ CO2 HCO3- CO3-2
	    equilibrium_phases CO2(g)
	    saturation_indices CO2(g)
	USER_PUNCH 1
	    headings solution_volume_L water_activity phi_CO2 inferred_pCO2_atm
	    start
	    10 phi = PR_PHI("CO2(g)")
	    20 IF phi <= 0 THEN phi = 1
	    30 PUNCH SOLN_VOL, ACT("H2O"), phi, 10^SI("CO2(g)")/phi
	    end
